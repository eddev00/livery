{
  "permissions": {
    "deny": [
      "Read(out/**)",
      "Edit(out/**)",
      "Write(out/**)",
      "Read(~/livery-live/**)",
      "Edit(~/livery-live/**)",
      "Write(~/livery-live/**)",
      "Bash(*livery-live*)"
    ],
    "blockReadsOutsideWorkingDirectories": true
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": ["~/livery-live", "out"],
      "allowRead": ["~/.local/share/uv", "~/.cache/uv", "~/.local/share/mise", "~/.local/bin"]
    }
  }
}

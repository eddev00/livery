{
  "permissions": {
    "deny": [
      "Read(out/**)",
      "Edit(out/**)",
      "Write(out/**)",
      "Read(~/wordeasy-live/**)",
      "Edit(~/wordeasy-live/**)",
      "Write(~/wordeasy-live/**)",
      "Bash(*wordeasy-live*)"
    ],
    "blockReadsOutsideWorkingDirectories": true
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": ["~/wordeasy-live", "out"],
      "allowRead": ["~/.local/share/uv", "~/.cache/uv", "~/.local/share/mise", "~/.local/bin"]
    }
  }
}
